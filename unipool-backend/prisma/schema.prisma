generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  male
  female
}

enum UserRole {
  student
  admin
}

enum NotificationChannel {
  EMAIL
  IN_APP_TOAST
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum RideType {
  SCHEDULED
  INSTANT
}

enum GenderPreference {
  ANY
  FEMALES_ONLY
}

enum RideStatus {
  PUBLISHED
  CANCELLED
  COMPLETED
}

model User {
  id                  String              @id @default(uuid())
  fullName            String
  ibaEmail            String              @unique
  password            String
  phone               String?
  studentErp          String?             @unique
  gender              Gender
  role                UserRole            @default(student)
  trustScore          Float               @default(5.0)
  isVerified          Boolean             @default(false)
  genderVerified      Boolean             @default(false)
  isDriver            Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  vehicles            Vehicle[]           @relation("DriverVehicles")
  rides               Ride[]              @relation("DriverRides")
  routeSubscriptions  RouteSubscription[]
  activeRouteSearches ActiveRouteSearch[]
  notifications       Notification[]
}

model Vehicle {
  id                 String   @id @default(uuid())
  driverId           String
  driver             User     @relation("DriverVehicles", fields: [driverId], references: [id])
  make               String
  model              String
  color              String
  registrationNumber String   @unique
  imageUrl           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  rides Ride[]
}

model Ride {
  id                   String           @id @default(uuid())
  driverId             String
  driver               User             @relation("DriverRides", fields: [driverId], references: [id])
  vehicleId            String
  vehicle              Vehicle          @relation(fields: [vehicleId], references: [id])
  startLocation        String
  destinationLocation  String
  departureTime        DateTime
  targetSlot           String? // e.g. "08:30 AM Class"
  rideType             RideType
  seatsTotal           Int
  seatsAvailable       Int
  farePerSeat          Float
  genderPreference     GenderPreference @default(ANY)
  status               RideStatus       @default(PUBLISHED)
  isUrgent             Boolean          @default(false)
  routeKey             String?
  destinationKey       String?
  routeGeometry        Json?
  distanceKm           Float?
  durationMin          Int?
  suggestedFarePerSeat Float?
  fareCap              Float?
  mappingProvider      String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  stops         RideStop[]
  notifications Notification[]
}

model RideStop {
  id          String  @id @default(uuid())
  rideId      String
  ride        Ride    @relation(fields: [rideId], references: [id], onDelete: Cascade)
  stopName    String
  sequence    Int
  lat         Float?
  lng         Float?
  isSuggested Boolean @default(false)
  isConfirmed Boolean @default(true)
}

model RouteSubscription {
  id                  String              @id @default(uuid())
  userId              String
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  routeKey            String
  destinationKey      String?
  startLocation       String
  destinationLocation String
  channel             NotificationChannel @default(EMAIL)
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([userId, routeKey])
  @@index([routeKey, isActive])
  @@index([destinationKey, isActive])
}

model ActiveRouteSearch {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  routeKey            String
  destinationKey      String?
  startLocation       String
  destinationLocation String
  isActive            Boolean  @default(true)
  lastSeenAt          DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([userId, routeKey])
  @@index([routeKey, isActive])
  @@index([destinationKey, isActive])
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  rideId    String?
  ride      Ride?               @relation(fields: [rideId], references: [id], onDelete: SetNull)
  channel   NotificationChannel
  status    NotificationStatus  @default(PENDING)
  title     String
  message   String
  payload   Json?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([userId, createdAt])
}

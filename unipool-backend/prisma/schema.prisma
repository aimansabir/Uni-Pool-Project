generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  male
  female
}

enum UserRole {
  student
  admin
}

model User {
  id          String   @id @default(uuid())
  fullName    String
  ibaEmail    String   @unique
  password    String
  phone       String?
  studentErp  String?  @unique
  gender      Gender
  role        UserRole @default(student)
  trustScore  Float    @default(5.0)
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  vehicles Vehicle[] @relation("DriverVehicles")
  rides    Ride[]    @relation("DriverRides")
}

model Vehicle {
  id                 String   @id @default(uuid())
  driverId           String
  driver             User     @relation("DriverVehicles", fields: [driverId], references: [id])
  make               String
  model              String
  color              String
  registrationNumber String   @unique
  imageUrl           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  rides              Ride[]
}

model Ride {
  id                  String     @id @default(uuid())
  driverId            String
  driver              User       @relation("DriverRides", fields: [driverId], references: [id])
  vehicleId           String
  vehicle             Vehicle    @relation(fields: [vehicleId], references: [id])
  startLocation       String
  destinationLocation String
  departureTime       DateTime
  targetSlot          String?    // e.g. "08:30 AM Class"
  rideType            String     // "SCHEDULED" | "INSTANT"
  seatsTotal          Int
  seatsAvailable      Int
  farePerSeat         Float
  genderPreference    String     @default("ANY")
  status              String     @default("PUBLISHED")
  isUrgent            Boolean    @default(false)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  stops               RideStop[]
}

model RideStop {
  id        String  @id @default(uuid())
  rideId    String
  ride      Ride    @relation(fields: [rideId], references: [id])
  stopName  String
  sequence  Int
  lat       Float?
  lng       Float?
}
# ============================================
# UniPool Backend – Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ---- Required ----

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/unipool_db"

# Secret key used to sign JWT tokens (use a long random string)
JWT_SECRET="your_jwt_secret_here"

# ---- Optional ----

# Port the server listens on (default: 3000)
PORT=3000

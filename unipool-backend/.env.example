# ───────────────────────────────────────────────────────────────
# UniPool Backend – Environment Variables
# ───────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# ───────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/unipool_db"

# Secret key for signing JWT tokens
JWT_SECRET="change_me_to_a_strong_random_secret"

# ── Optional ──────────────────────────────────────────────────

# Server port (default: 3000)
PORT=3000

# Base URL for generating tracking links (leave empty for relative paths)
APP_BASE_URL=""

# ── Mapping / Route Intelligence ──────────────────────────────

# Nominatim geocoding API base URL
ROUTE_GEOCODER_BASE_URL="https://nominatim.openstreetmap.org"

# OSRM routing engine base URL
ROUTE_ENGINE_BASE_URL="https://router.project-osrm.org"

# Email for Nominatim usage policy compliance
NOMINATIM_EMAIL="your-email@example.com"

# User-Agent header for Nominatim requests
NOMINATIM_USER_AGENT="uni-pool-backend/1.0"

# ── Fare Calculation ──────────────────────────────────────────

# Base fare in PKR
FARE_BASE_PKR=60

# Per-kilometer fare rate in PKR
FARE_PER_KM_PKR=18

# Maximum multiplier over suggested fare (fare cap)
FARE_MAX_MULTIPLIER=1.25

# Radius in meters to detect landmarks along a route
LANDMARK_RADIUS_METERS=700

# ── Email (SMTP) ─────────────────────────────────────────────

# SMTP server host for email notifications
SMTP_HOST=""

# SMTP server port
SMTP_PORT=587

# Use TLS for SMTP (true/false)
SMTP_SECURE=false

# SMTP authentication username
SMTP_USER=""

# SMTP authentication password
SMTP_PASS=""

# "From" address for outgoing emails
SMTP_FROM="UniPool <no-reply@unipool.local>"

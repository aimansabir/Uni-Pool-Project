# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
DATABASE_URL="postgresql://<USER>:<PASSWORD>@localhost:5432/unipool_db"

# ──────────────────────────────────────────────
# Authentication
# ──────────────────────────────────────────────
JWT_SECRET="change_me_to_a_long_random_string"

# ──────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────
PORT=3000

# ──────────────────────────────────────────────
# Mapping / Route Intelligence (Nominatim + OSRM)
# ──────────────────────────────────────────────
ROUTE_GEOCODER_BASE_URL="https://nominatim.openstreetmap.org"
ROUTE_ENGINE_BASE_URL="https://router.project-osrm.org"
NOMINATIM_EMAIL="your-email@example.com"
NOMINATIM_USER_AGENT="uni-pool-backend/1.0"

# ──────────────────────────────────────────────
# Fare Calculation
# ──────────────────────────────────────────────
FARE_BASE_PKR=60
FARE_PER_KM_PKR=18
FARE_MAX_MULTIPLIER=1.25
LANDMARK_RADIUS_METERS=700

# ──────────────────────────────────────────────
# Email / SMTP (optional – leave blank to disable)
# ──────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="UniPool <no-reply@unipool.local>"
